# Internal assistant working notes — not part of the deployable product.
memory/

# Raw 1-min CSV history (multi-GB) — distilled into server/data/history.json.
# Anchored to repo root so it does NOT also ignore server/data/ on
# case-insensitive filesystems (Windows/macOS).
/Data/

# Transient SQLite sidecar files — the committed .db is self-contained
# (checkpointed). These are recreated at runtime and must never be tracked.
*.db-wal
*.db-shm
*.db-shm.txt
*.db-journal

