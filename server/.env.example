# ============================================================================
# Voltaire Terminal — backend environment
# Copy this file to `server/.env` and fill in the values you have.
# Everything works WITHOUT a key except the EIA-backed panels (US inventories,
# refinery utilization, official spot, weekly builds/draws, OPEC production).
# ============================================================================

# EIA Open Data API key — free, instant signup: https://www.eia.gov/opendata/register.php
# Without it, the inventory/refinery/stock-flow panels fall back to seeded data.
EIA_API_KEY=

# Port the Express backend listens on (Vite dev proxy forwards /api here).
PORT=3001
